# Required: generate a strong random key before starting the server
SECRET_KEY=replace-with-a-long-random-secret-key

# SQLite database URL (relative path resolves inside Flask's instance/ directory)
DATABASE_URL=sqlite:///campusconnect.db

# Comma-separated allowed frontend origins (no wildcard '*')
FRONTEND_ORIGINS=http://localhost:5173,http://192.168.1.20:5173

# Server binding and debug settings
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# JWT token lifetime in hours
JWT_EXPIRY_HOURS=24
